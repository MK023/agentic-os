# Pinned to a patch version, not the moving 3.14-slim tag — same reasoning as the
# compose file's image pins.
# Pinnata per DIGEST oltre che per tag: un tag e' un'etichetta e si puo' ripuntare
# sotto lo stesso nome. Il ragionamento per esteso sta in docs/DECISIONS.md.
FROM python:3.14.7-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

# stdout non bufferizzato: sotto Railway e' una pipe, non un TTY, quindi CPython lo
# bufferizza a blocchi da 8 KB e su SIGKILL o OOM la coda dei log sparisce. Su un
# servizio il cui unico guasto di produzione e' stato trovato leggendo i log a mano,
# perdere proprio le ultime righe e' la direzione sbagliata.
ENV PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt .
# --require-hashes: every resolved version is locked to a hash (requirements.txt is
# generated by pip-compile --generate-hashes from requirements.in) — same reasoning
# as SHA-pinning GitHub Actions, and what Sonar's docker:S8544 asks for.
# --only-binary :all:: wheels only, never a source distribution whose setup.py would
# execute at install time (docker:S8541).
RUN pip install --no-cache-dir --require-hashes --only-binary :all: -r requirements.txt
COPY main.py sentry.py ./

# Runs unprivileged: nothing here needs root. Il `cap_drop`/`no-new-privileges` del
# compose vale SOLO in locale — Railway non espone quelle impostazioni — quindi in
# produzione questo `USER` e' l'intera postura del container, non un secondo strato.
USER 65534:65534

# Compose has no Kubernetes liveness probe to lean on, so this is the only
# automatic signal that the container is serving rather than merely running.
# Shell form, so $STATUS_API_TOKEN is expanded at check time. Uses stdlib urllib
# instead of curl: python:3.14-slim is Debian-slim and ships no curl, and adding
# an apt layer just to healthcheck would be a bigger image for no gain.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import os,urllib.request as u; u.urlopen(u.Request('http://localhost:8000/status', headers={'Authorization': 'Bearer ' + os.environ['STATUS_API_TOKEN']}), timeout=4)" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
