# Local environment only. In production these are Railway service variables —
# see railway/README.md. Never commit a real .env.
# SENTRY_DSN is optional: without it the status API's error capture is a no-op.

CLOUDFLARE_TUNNEL_TOKEN=
GRAFANA_ADMIN_PASSWORD=
STATUS_API_TOKEN=
OTLP_INGEST_TOKEN=
SENTRY_DSN=
# Facoltativa come SENTRY_DSN: vuota, le regole d'allarme valutano e nessuna
# notifica esce (docker/grafana/entrypoint.sh mette un segnaposto e lo dice).
SLACK_WEBHOOK_URL=

# Fase 1.5 — Loki. In locale bastano valori qualunque solo se non avvii `loki`:
# con credenziali vuote il servizio entra in crash loop rumoroso
# ("The Access Key Id you provided does not exist in our records"), che e' il
# comportamento voluto. Per una prova senza R2 usa scripts/prova-privacy-log.sh,
# che alza un MinIO e non chiede niente qui.
# L'ENDPOINT VA SENZA SCHEMA: la doc Cloudflare lo pubblica con `https://`,
# `-verify-config` lo accetta, e Loki muore all'avvio.
LOKI_R2_BUCKET=
LOKI_R2_ENDPOINT=
LOKI_R2_ACCESS_KEY_ID=
LOKI_R2_SECRET_ACCESS_KEY=
