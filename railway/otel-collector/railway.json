{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "railway/otel-collector/Dockerfile",
    "watchPatterns": [
      "docker/otel-collector-config.yaml",
      "railway/otel-collector/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
