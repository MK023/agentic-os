{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "railway/prometheus/Dockerfile",
    "watchPatterns": [
      "docker/prometheus.yml",
      "railway/prometheus/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}
